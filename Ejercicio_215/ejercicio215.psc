Proceso TablaMultiplicarMatriz
    Definir N, i, j Como Entero
    Escribir "Ingrese el tamaño de la tabla de multiplicar:"
    Leer N
	
    Para i <- 1 Hasta N Hacer
        Para j <- 1 Hasta N Hacer
            Escribir Sin Saltar i * j, " "
        FinPara
        Escribir ""
    FinPara
FinProceso
