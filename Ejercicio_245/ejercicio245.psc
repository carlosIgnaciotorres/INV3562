Proceso ConvertirDolaresAEuros
    Definir dolares, tasa, euros Como Real
    
    Escribir "Ingrese la cantidad en dólares:"
    Leer dolares
    
    Escribir "Ingrese la tasa de cambio (1 dólar a cuántos euros equivale):"
    Leer tasa
    
    euros <- dolares * tasa
    
    Escribir "El equivalente en euros es:", euros
FinProceso
