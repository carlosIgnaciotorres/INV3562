Algoritmo NumeroAleatorioDFD
    Definir minimo, maximo, numero Como Entero
	
    Escribir "Ingrese el valor mínimo del rango:"
    Leer minimo
    Escribir "Ingrese el valor máximo del rango:"
    Leer maximo
	
    numero <- Aleatorio(minimo, maximo) // Genera un número aleatorio en el rango
	
